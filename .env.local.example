# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=room-photos

# Plan 3 AI services (unused in Plan 1 — set to empty strings)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=

# Plan 3 live catalog fallback (unused in Plan 1 — set to empty strings)
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
EBAY_APP_ID=
