# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=room-photos

# Plan 3 services (unused in Plan 1 — set to empty strings)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=

# Catalog sync sources
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SYNC_PER_CATEGORY=10
SYNC_DEFAULT_ZIP=10003

# Vercel Cron auth
CRON_SECRET=

# Error monitoring
SENTRY_DSN=

# Rate limiting (requests per second)
RATE_LIMIT_PICKS_PER_SEC=1
RATE_LIMIT_UPLOAD_PER_SEC=10
